# Base URL of the Laravel backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# VAPID public key for web push (backend D-034). The backend hands it over
# separately; it is not in either repository. Without it the notifications
# card stays hidden and email remains the only channel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Public origin of this web app, no trailing slash (e.g. https://example.kz).
# It goes into QR codes, share links and OpenGraph URLs, and is inlined at
# `next build` - set it before building a production bundle. Left empty, the
# browser's own origin is used, which is fine for local and LAN testing.
NEXT_PUBLIC_APP_URL=
