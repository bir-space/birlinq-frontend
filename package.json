{
  "name": "birlinq-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @birlinq/web",
    "build": "npm run build --workspace @birlinq/web",
    "start": "npm run start --workspace @birlinq/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
